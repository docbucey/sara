  "header_spec": {
    "name": "canonical_bucey_shunt_header",
    "logical_control_bits": 24,
    "physical_bytes": 6,
    "reserved_padding_bytes": 210,
    "byte_map": {
      "BYTE0": {
        "name": "shunt_mode_enable",
        "description": "Enables Bucey Shunt mode.",
        "values": {
          "00": "disabled",
          "01": "enabled"
        }
      },
      "BYTE1": {
        "name": "domain_origin_authority_routing",
        "description": "Encodes domain, origin, authority, and routing in 2-bit groups.",
        "bit_fields": {
          "domain_bits": {
            "bits": "7-6",
            "values": {
              "00": "LOCAL_CORE_CPU",
              "01": "CONTROL_ORCHESTRATION",
              "10": "SECURITY_COMPLIANCE",
              "11": "INTERFACE_ADAPTER_SURFACE"
            }
          },
          "origin_bits": {
            "bits": "5-4",
            "values": {
              "00": "CORE_TRADITIONAL",
              "01": "CONTROL_NATIVE",
              "10": "SECURITY_NATIVE",
              "11": "MAMA_OR_SDK_FORWARDER"
            }
          },
          "authority_bits": {
            "bits": "3-2",
            "values": {
              "00": "READ_ONLY",
              "01": "VALIDATE_GATE",
              "10": "PRESENT_STORE",
              "11": "CONTROL_EXECUTE"
            }
          },
          "routing_bits": {
            "bits": "1-0",
            "values": {
              "00": "RETURN_OR_NOOP",
              "01": "CONTROL_FIRST_STANDARD",
              "10": "SECURITY_GATE_FIRST",
              "11": "AMIPI_OR_ADAPTER_LANE"
            }
          }
        }
      },
      "BYTE2": {
        "name": "envoy_resonator_switch",
        "description": "Selects the standard lane or Envoy/Resonator lane context.",
        "values": {
          "00": "standard_control_lane",
          "01": "envoy_or_resonator_lane"
        }
      },
      "BYTE3": {
        "name": "filename_orchestrator_lane",
        "description": "Encodes file/pattern hints and the final lane selector.",
        "bit_fields": {
          "filename_bits": {
            "bits": "7-6"
          },
          "orchestrator_pattern_bits": {
            "bits": "5-2"
          },
          "lane_bits": {
            "bits": "1-0",
            "values": {
              "00": "core_control_lane",
              "01": "mama_presentation_lane",
              "10": "sdk_amipi_adapter_lane",
              "11": "security_or_stables_lane"
            }
          }
        }
      },
      "BYTE4": {
        "name": "extension_signature_domain_confirm",
        "description": "Confirms extension class and domain alignment.",
        "bit_fields": {
          "extension_signature_bits": {
            "bits": "7-6"
          },
          "domain_confirm_bits": {
            "bits": "5-4"
          }
        }
      },
      "BYTE5": {
        "name": "authority_and_lock",
        "description": "Encodes shunt authority level and lock state.",
        "bit_fields": {
          "shunt_authority_bits": {
            "bits": "7-4",
            "values": {
              "0": "inbound_only",
              "1": "read_allowed",
              "2": "validate_or_route",
              "3": "execute_write_control_owned"
            }
          },
          "shunt_lock_bits": {
            "bits": "3-0",
            "values": {
              "0": "read_only",
              "1": "control_owned_lock",
              "2": "security_gate_lock",
              "3": "reserved_strict_lock"
            }
          }
        }
      }
    }
  },
