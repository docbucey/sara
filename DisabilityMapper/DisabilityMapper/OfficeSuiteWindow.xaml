<Window x:Class="DisabilityMapper.OfficeSuiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SARA — Office &amp; Workspace"
        Width="980" Height="760"
        MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <Window.Resources>
        <SolidColorBrush x:Key="BgWin"   Color="#F4F6FA"/>
        <SolidColorBrush x:Key="BgSurf"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgRaise" Color="#E8EDF5"/>
        <SolidColorBrush x:Key="AccentA" Color="#2F6FED"/>
        <SolidColorBrush x:Key="AccentB" Color="#1BA05E"/>
        <SolidColorBrush x:Key="FgPrim"  Color="#1A1A2E"/>
        <SolidColorBrush x:Key="FgSub"   Color="#5A6070"/>
        <SolidColorBrush x:Key="Warning" Color="#C0392B"/>
        <SolidColorBrush x:Key="Border"  Color="#C8D0E0"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgSurf}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="CaretBrush"      Value="{StaticResource FgPrim}"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentA}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="4,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A5CC8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Background"      Value="{StaticResource BgRaise}"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentA}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0DCF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnLaunch" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Background"      Value="{StaticResource BgRaise}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="18,12"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="Padding"    Value="18,8"/>
            <Setter Property="Foreground" Value="{StaticResource FgSub}"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource BgWin}">

        <!-- HEADER -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSurf}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Office &amp; Workspace" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource AccentA}"/>
                    <TextBlock Text="Documents · Email · Calendar · SARA Addon IDE"
                               FontSize="13" Foreground="{StaticResource FgSub}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Fatigue:" FontSize="14" Foreground="{StaticResource FgSub}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border x:Name="FatigueBar" Width="64" Height="18" CornerRadius="9"
                            BorderThickness="1" BorderBrush="{StaticResource Border}">
                        <Border.Background><SolidColorBrush Color="#1BA05E"/></Border.Background>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgRaise}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Ellipse x:Name="SaraDot" Width="10" Height="10"
                         DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Connecting..."
                           Foreground="{StaticResource FgSub}" FontSize="14" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- TABS -->
        <TabControl Background="{StaticResource BgWin}" BorderThickness="0">

            <!-- ═══ OFFICE TAB ═══ -->
            <TabItem Header="Office">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" x:Name="InputBox"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="Type a prompt, URL, or document content here"/>

                    <Border Grid.Row="1" Padding="0,8">
                        <WrapPanel>
                            <Button Style="{StaticResource BtnStyle}"    Content="Ask SARA"
                                    Click="AskSara_Click" x:Name="AskBtn"/>
                            <Button Style="{StaticResource BtnStyle}"    Content="Draft Document"
                                    Click="DraftDocx_Click"
                                    ToolTip="SARA writes a full document from your prompt"/>
                            <Button Style="{StaticResource BtnSecondary}" Content="Browse URL"
                                    Click="WebBrowse_Click"
                                    ToolTip="Paste a URL above and fetch the page text"/>
                            <Button Style="{StaticResource BtnSecondary}" Content="Search Web"
                                    Click="WebSearch_Click"/>
                            <Button Style="{StaticResource BtnSecondary}" Content="Save .docx"
                                    Click="SaveDocx_Click"/>
                            <Button Style="{StaticResource BtnSecondary}" Content="Save .xlsx"
                                    Click="SaveXlsx_Click"/>
                            <Button Style="{StaticResource BtnSecondary}" Content="Save .pdf"
                                    Click="SavePdf_Click"/>
                            <Button Style="{StaticResource BtnSecondary}" Content="Clear"
                                    Click="Clear_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="4">
                        <TextBox x:Name="ResponseBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#F8FAFD" BorderThickness="0" FontSize="15"/>
                    </Border>

                    <TextBlock Grid.Row="3" x:Name="SaveStatus" Text="" FontSize="14"
                               Foreground="{StaticResource AccentB}" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <!-- ═══ COMMUNICATIONS TAB ═══ -->
            <TabItem Header="Communications">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,12">
                    <StackPanel>

                        <TextBlock Text="Email" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentA}" Margin="0,0,0,6"/>
                        <TextBlock Text="Format:  recipient@email.com | Subject | Message body"
                                   FontSize="13" Foreground="{StaticResource FgSub}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmailBox" Height="80" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,8"
                                 ToolTip="recipient@email.com | Subject | Body"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Style="{StaticResource BtnStyle}"     Content="Send Email"
                                    Click="SendEmail_Click"/>
                            <Button Style="{StaticResource BtnSecondary}" Content="View Calendar"
                                    Click="CalendarList_Click"/>
                        </WrapPanel>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,20">
                            <TextBox x:Name="CommResponseBox" IsReadOnly="True" AcceptsReturn="True"
                                     Height="120" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#F8FAFD" BorderThickness="0"/>
                        </Border>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,16"/>

                        <TextBlock Text="Launch Communication Apps" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentA}" Margin="0,0,0,4"/>
                        <TextBlock Text="Opens the app if it is installed on this computer."
                                   FontSize="13" Foreground="{StaticResource FgSub}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Style="{StaticResource BtnLaunch}" Content="Microsoft Teams"
                                    Click="OpenTeams_Click"   Width="170"/>
                            <Button Style="{StaticResource BtnLaunch}" Content="Zoom"
                                    Click="OpenZoom_Click"    Width="170"/>
                            <Button Style="{StaticResource BtnLaunch}" Content="Slack"
                                    Click="OpenSlack_Click"   Width="170"/>
                            <Button Style="{StaticResource BtnLaunch}" Content="Outlook"
                                    Click="OpenOutlook_Click" Width="170"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SARA ADDON IDE TAB ═══ -->
            <TabItem Header="SARA Addon IDE">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="120"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: SARA project tree ── -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondary}"
                                    Content="↺" Click="RefreshTree_Click"
                                    Padding="8,4" FontSize="14" Margin="0" Width="32"
                                    ToolTip="Refresh file tree"/>
                            <TextBlock Text="SARA Project" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentA}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="4">
                            <TreeView x:Name="SaraTree" Background="{StaticResource BgSurf}"
                                      BorderThickness="0" FontSize="13"
                                      SelectedItemChanged="SaraTree_SelectedItemChanged"/>
                        </Border>

                        <!-- Register as Addon panel -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="Save addon to pillar:" FontSize="13"
                                       Foreground="{StaticResource FgSub}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PillarCombo" FontSize="14" Margin="0,0,0,6">
                                <ComboBoxItem Content="sara_control" IsSelected="True"/>
                                <ComboBoxItem Content="sara_core"/>
                                <ComboBoxItem Content="sara_mama"/>
                                <ComboBoxItem Content="sara_security"/>
                                <ComboBoxItem Content="sara_sdk"/>
                                <ComboBoxItem Content="addons/smithy"/>
                            </ComboBox>
                            <Button Style="{StaticResource BtnStyle}" Content="Register as Addon"
                                    Click="RegisterAddon_Click" Padding="12,8"
                                    ToolTip="Save current script into the selected SARA pillar folder"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── SPLITTER ── -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="{StaticResource Border}"/>

                    <!-- ── RIGHT: Editor + run + output ── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="90"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="Addon editor"
                                       FontSize="14" Foreground="{StaticResource FgSub}"
                                       VerticalAlignment="Center"/>
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnSecondary}" Content="Open .py"
                                        Click="OpenPyFile_Click" Padding="12,6"/>
                                <Button Style="{StaticResource BtnSecondary}" Content="Save .py"
                                        Click="SavePyFile_Click" Padding="12,6"/>
                                <Button Style="{StaticResource BtnSecondary}" Content="Clear"
                                        Click="ClearPython_Click" Padding="12,6"/>
                            </WrapPanel>
                        </DockPanel>

                        <!-- Code editor -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="PyEditorBox"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Courier New" FontSize="15"
                                     Background="#1E2030" Foreground="#CDD6F4"
                                     CaretBrush="#CDD6F4" BorderThickness="0" Padding="10"/>
                        </Border>

                        <!-- Run row -->
                        <DockPanel Grid.Row="2" Margin="0,8,0,6">
                            <Button DockPanel.Dock="Left" Style="{StaticResource BtnStyle}"
                                    Content="Run Script" Click="RunPython_Click"
                                    x:Name="RunBtn" Padding="22,10"/>
                            <TextBlock x:Name="PyStatusText" Text=""
                                       FontSize="14" Foreground="{StaticResource FgSub}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </DockPanel>

                        <!-- Output area -->
                        <Border Grid.Row="3" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="PyOutputBox" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Courier New" FontSize="14"
                                     Background="#151720" Foreground="#A6E3A1"
                                     BorderThickness="0" Padding="10"/>
                        </Border>

                        <TextBlock Grid.Row="4" FontSize="13" Foreground="{StaticResource FgSub}"
                                   Margin="0,6,0,0"
                                   Text="Scripts run via SARA CONTROL · 30-second timeout · Click a .py file in the tree to open it"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
