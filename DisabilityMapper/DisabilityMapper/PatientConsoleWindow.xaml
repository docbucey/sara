<Window x:Class="DisabilityMapper.PatientConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SARA — Patient Console"
        Width="1020" Height="740"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B1829"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- ── Palette ─────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="Bg0"     Color="#0B1829"/>
        <SolidColorBrush x:Key="Bg1"     Color="#112236"/>
        <SolidColorBrush x:Key="Bg2"     Color="#1A3450"/>
        <SolidColorBrush x:Key="BgSide"  Color="#07111E"/>
        <SolidColorBrush x:Key="BgPlay"  Color="#071A10"/>
        <SolidColorBrush x:Key="AccentA" Color="#1B4F8A"/>
        <SolidColorBrush x:Key="AccentB" Color="#2E9E6B"/>
        <SolidColorBrush x:Key="AccentC" Color="#7B3FA0"/>
        <SolidColorBrush x:Key="FgPrim"  Color="#E8F0F8"/>
        <SolidColorBrush x:Key="FgSub"   Color="#6A90B8"/>
        <SolidColorBrush x:Key="Warning" Color="#E04040"/>

        <!-- ── Bool→Visibility ─────────────────────────────────────── -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Base TextBlock override ─────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
        </Style>

        <!-- ── Sport pill ListBoxItem ──────────────────────────────── -->
        <Style x:Key="SportPillItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="#112236"
                                BorderBrush="#1A3450"
                                BorderThickness="2"
                                CornerRadius="22"
                                Padding="18,10"
                                Cursor="Hand">
                            <TextBlock x:Name="txt"
                                       Text="{TemplateBinding Content}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#E8F0F8"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd"  Property="BorderBrush"  Value="#2E9E6B"/>
                                <Setter TargetName="bd"  Property="Background"   Value="#0D2A1A"/>
                                <Setter TargetName="txt" Property="Foreground"   Value="#2E9E6B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1B4F8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Team tile ListBoxItem ───────────────────────────────── -->
        <Style x:Key="TeamTileItem" TargetType="ListBoxItem">
            <Setter Property="Margin"  Value="4"/>
            <Setter Property="Width"   Value="148"/>
            <Setter Property="Height"  Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="#112236"
                                BorderBrush="#1A3450"
                                BorderThickness="2"
                                CornerRadius="6"
                                Cursor="Hand">
                            <TextBlock x:Name="txt"
                                       Text="{TemplateBinding Content}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E8F0F8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd"  Property="BorderBrush"  Value="#2E9E6B"/>
                                <Setter TargetName="bd"  Property="Background"   Value="#0D2A1A"/>
                                <Setter TargetName="txt" Property="Foreground"   Value="#2E9E6B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1B4F8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>  <!-- top bar  -->
            <RowDefinition Height="*"/>   <!-- content  -->
        </Grid.RowDefinitions>

        <!-- ═══════════════ TOP BAR ═══════════════ -->
        <Border Grid.Row="0"
                Background="#07111E"
                BorderThickness="0,0,0,1"
                BorderBrush="#1B3450">
            <DockPanel Margin="16,0" VerticalAlignment="Center">
                <!-- Wordmark -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1B4F8A" CornerRadius="3"
                            Padding="9,4" Margin="0,0,10,0">
                        <TextBlock Text="SARA" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Patient Console" FontSize="15"
                               Foreground="#6A90B8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Fullscreen toggle -->
                <Button DockPanel.Dock="Right"
                        x:Name="BtnFullscreen"
                        Content="⤢  Full Screen"
                        Click="ToggleFullscreen_Click"
                        Background="Transparent"
                        BorderBrush="#1A3450"
                        BorderThickness="1"
                        Foreground="#6A90B8"
                        FontSize="12"
                        Padding="12,5"
                        Margin="0"
                        Cursor="Hand"/>
            </DockPanel>
        </Border>

        <!-- ═══════════════ CONTENT AREA ═══════════════ -->
        <Grid Grid.Row="1">

            <!-- ── PICKERS VIEW (IsNotPlaying) ───────────────────── -->
            <Grid Visibility="{Binding IsNotPlaying, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- sport section  -->
                    <RowDefinition Height="*"/>    <!-- team pickers   -->
                    <RowDefinition Height="90"/>   <!-- PLAY button    -->
                </Grid.RowDefinitions>

                <!-- SPORT SECTION -->
                <Border Grid.Row="0"
                        Background="#112236"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#1A3450"
                        Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="PICK YOUR SPORT"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#6A90B8"
                                   Margin="0,0,0,10"/>
                        <ListBox x:Name="SportList"
                                 ItemsSource="{Binding Sports}"
                                 SelectedItem="{Binding SelectedSport}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SportPillItem}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- TEAM PICKERS -->
                <Grid Grid.Row="1" Margin="20,16,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- YOUR TEAM column -->
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="YOUR TEAM"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#6A90B8"
                                       VerticalAlignment="Center"/>
                            <Border Background="#2E9E6B" CornerRadius="3"
                                    Padding="8,2" Margin="10,0,0,0"
                                    Visibility="{Binding IsPatientTeamSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="PatientTeamBadge"
                                           Text="{Binding PatientTeam}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#0B1829"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="PatientTeamList"
                                     ItemsSource="{Binding Teams}"
                                     SelectedItem="{Binding PatientTeam}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource TeamTileItem}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1"
                            Width="1"
                            Background="#1A3450"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,4"/>

                    <!-- OPPONENT column -->
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="OPPONENT"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#6A90B8"
                                       VerticalAlignment="Center"/>
                            <Border Background="#E06B24" CornerRadius="3"
                                    Padding="8,2" Margin="10,0,0,0"
                                    Visibility="{Binding IsOpponentTeamSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="OpponentTeamBadge"
                                           Text="{Binding OpponentTeam}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="OpponentTeamList"
                                     ItemsSource="{Binding Teams}"
                                     SelectedItem="{Binding OpponentTeam}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource TeamTileItem}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- PLAY BUTTON STRIP -->
                <Border Grid.Row="2"
                        Background="#071A10"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#2E9E6B">
                    <Button Command="{Binding PlayCommand}"
                            Background="#2E9E6B"
                            Foreground="White"
                            FontSize="22"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Width="280"
                            Height="56"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="playBd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="playBd" Property="Background" Value="#1A3450"/>
                                        <Setter Property="Foreground" Value="#3A5070"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="playBd" Property="Background" Value="#22B87A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="playBd" Property="Background" Value="#1E7A52"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        ▶   PLAY
                    </Button>
                </Border>
            </Grid>

            <!-- ── NOW PLAYING VIEW (IsPlaying) ───────────────────── -->
            <Grid Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Sport name -->
                    <TextBlock Text="{Binding SelectedSport}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="#E8F0F8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Teams -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PatientTeam}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="#2E9E6B"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="YOUR TEAM"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#6A90B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="vs"
                                   FontSize="28"
                                   Foreground="#6A90B8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OpponentTeam}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="#E06B24"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="OPPONENT"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#6A90B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Live indicator -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,32">
                        <Ellipse Width="10" Height="10"
                                 Fill="#2E9E6B"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.2" Duration="0:0:0.9"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="Console Bridge Active"
                                   FontSize="14" Foreground="#2E9E6B"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- STOP button -->
                    <Button Command="{Binding StopCommand}"
                            Background="#7B3FA0"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Width="200"
                            Height="48"
                            HorizontalAlignment="Center"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="stopBd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="stopBd" Property="Background" Value="#9A55C0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="stopBd" Property="Background" Value="#5A2A7A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        ⏹  STOP
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
