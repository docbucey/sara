<Window x:Class="DisabilityMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DisabilityMapper.ViewModels"
        Title="SARA — Accessibility Input Mapper"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <Window.Resources>
        <!-- LIGHT THEME -->
        <SolidColorBrush x:Key="Bg0"      Color="#F4F6FA"/>  <!-- Window bg -->
        <SolidColorBrush x:Key="Bg1"      Color="#FFFFFF"/>  <!-- Surface -->
        <SolidColorBrush x:Key="Bg2"      Color="#E8EDF5"/>  <!-- Raised panel -->
        <SolidColorBrush x:Key="AccentA"  Color="#2F6FED"/>  <!-- Blue -->
        <SolidColorBrush x:Key="AccentB"  Color="#1BA05E"/>  <!-- Green -->
        <SolidColorBrush x:Key="FgPrim"   Color="#1A1A2E"/>  <!-- Dark text -->
        <SolidColorBrush x:Key="FgSub"    Color="#5A6070"/>  <!-- Secondary text -->
        <SolidColorBrush x:Key="Warning"  Color="#D93025"/>  <!-- Red -->
        <SolidColorBrush x:Key="Cyan"     Color="#5A7FBE"/>  <!-- Muted blue -->
        
        <vm:BoolToToggleLabelConverter x:Key="ToggleLabel"/>
        <vm:StringNotEmptyConverter    x:Key="NotEmpty"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource Bg1}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="CaretBrush"      Value="{StaticResource FgPrim}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource Bg1}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="15"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentA}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentA}"/>
                    <Setter Property="Foreground" Value="{StaticResource Bg0}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"      Value="{StaticResource AccentA}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin"          Value="0,8"/>
            <Setter Property="Padding"         Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource Bg2}" Padding="8" Margin="0,0,0,8" BorderThickness="2" BorderBrush="{StaticResource AccentA}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BtnStyle}"
                        Command="{Binding RefreshDevicesCommand}"
                        Content="Find My Devices" Margin="0,0,8,0" FontSize="16"
                        ToolTip="Look for any controllers, keyboards, or other devices plugged in"/>
                <Button Style="{StaticResource BtnStyle}"
                        Command="{Binding TogglePollingCommand}"
                        Content="{Binding IsPolling, Converter={StaticResource ToggleLabel}}"
                        Margin="0,0,8,0" FontSize="16"
                        ToolTip="Start or stop watching your devices for input"/>
                <Button Style="{StaticResource BtnStyle}"
                        Command="{Binding SaveAllCommand}"
                        Content="Save My Settings" FontSize="16"
                        ToolTip="Save everything you've set up"/>
                <Button Style="{StaticResource BtnStyle}"
                        Content="Office Suite" FontSize="16" Margin="8,0,0,0"
                        Click="OpenOffice_Click"
                        ToolTip="Open the SARA Office Suite"/>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentA}">
                        <TextBlock.Text>SARA — Your Everyday Helper</TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="16" Foreground="{StaticResource FgSub}">
                        <TextBlock.Text>Works with any input — controller · keyboard · mouse · voice · switch · joystick and more</TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT: 3-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="320" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0: DEVICE LIST -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}"
                    BorderThickness="2" BorderBrush="{StaticResource AccentA}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="My Devices"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentA}"
                               Margin="0,0,0,8"/>
                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,10" Margin="2,2,2,4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Ellipse Width="14" Height="14" Margin="0,0,8,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource AccentB}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="16">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource FgSub}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DeviceType}" FontSize="14"
                                                   Foreground="{StaticResource Cyan}" Margin="22,0,0,0"/>
                                        <TextBlock FontSize="13" Margin="22,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Text" Value="&#x2713; Plugged in and ready"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentB}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                            <Setter Property="Text" Value="Not connected"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground"  Value="{StaticResource FgPrim}"/>
                                <Setter Property="Background"  Value="Transparent"/>
                                <Setter Property="Padding"     Value="6,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Bg2}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentA}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- SPLITTER 1 -->
            <GridSplitter Grid.Column="1" Width="2"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentA}"/>

            <!-- COLUMN 2: MAPPER VISUALIZATION + SETTINGS -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource Bg0}">
                <ContentControl Content="{Binding SelectedDevice}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceProfileViewModel}">
                            <StackPanel Margin="12">

                                <!-- Device info header -->
                                <Border Background="{StaticResource Bg2}" Padding="8" Margin="0,0,0,12"
                                        BorderThickness="2" BorderBrush="{StaticResource Cyan}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentA}"/>
                                            <TextBlock Text="{Binding DeviceType}"
                                                       Foreground="{StaticResource Cyan}" FontSize="15" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="This device is on"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource FgPrim}"/>
                                    </Grid>
                                </Border>

                                <!-- Profile selector -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="My saved settings:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="{StaticResource AccentA}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileNames}"
                                              SelectedItem="{Binding SelectedProfileName}" FontSize="15"/>
                                    <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource BtnStyle}"
                                            Command="{Binding AddProfileCommand}" Content="+ New" Padding="8,2" FontSize="14"
                                            ToolTip="Create a new set of settings"/>
                                    <Button Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource BtnStyle}"
                                            Command="{Binding RemoveCurrentProfileCommand}" Content="Delete" Padding="8,2" FontSize="14"
                                            ToolTip="Remove this set of settings"/>
                                </Grid>

                                <!-- MY BUTTONS GRID -->
                                <GroupBox Header="My Buttons — tap any one to set it up" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="Tap any button below — then tell SARA what it should do"
                                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentA}"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Last input: " FontSize="14" Foreground="{StaticResource AccentA}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LastInput}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentB}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Button Grid -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MappingRows}" Margin="0,0,0,12">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="6" Padding="16,12" FontSize="14" FontWeight="Bold"
                                                            Command="{Binding DataContext.SelectMappingCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="140" Height="100"
                                                            Background="{StaticResource Bg2}"
                                                            BorderThickness="2"
                                                            Foreground="{StaticResource FgPrim}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BtnStyle}">
                                                                <Setter Property="BorderBrush" Value="{StaticResource FgSub}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentA}"/>
                                                                        <Setter Property="Background" Value="{StaticResource Cyan}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Bg0}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding InputName}" FontSize="15" FontWeight="Bold" TextAlignment="Center" Foreground="Inherit"/>
                                                            <TextBlock Text="↓" TextAlignment="Center" FontSize="14" Margin="0,4,0,4" Foreground="Inherit"/>
                                                            <TextBlock Text="{Binding CurrentMapping}" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Foreground="Inherit" MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Quick Actions -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.LearnInputCommand}"
                                                    Content="Teach SARA This Button" Padding="12,6" FontSize="15" Margin="0,0,8,0"
                                                    ToolTip="Press the physical button you want SARA to learn"/>
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.EditMappingCommand}"
                                                    Content="Set Up This Button" Padding="12,6" FontSize="15" Margin="0,0,8,0"
                                                    ToolTip="Change what this button does"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- BUTTON SETUP -->
                                <GroupBox Header="Button Setup — select a button above first" Margin="0,0,0,12">
                                    <Border Padding="12" Background="{StaticResource Bg1}" BorderThickness="2" BorderBrush="{StaticResource Cyan}">
                                        <StackPanel DataContext="{Binding SelectedMappingRow}">

                                            <!-- Which button is selected -->
                                            <Border Background="{StaticResource Bg2}" Padding="10,8" Margin="0,0,0,16"
                                                    BorderThickness="2" BorderBrush="{StaticResource AccentA}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="You picked:  " FontSize="15"
                                                               Foreground="{StaticResource FgSub}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding InputName}" FontSize="20" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentB}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- What should it do -->
                                            <TextBlock Text="What should SARA do when you press this?"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentA}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding ActionTypes}"
                                                      SelectedItem="{Binding ActionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="16" Margin="0,0,0,14"/>

                                            <!-- Which key -->
                                            <TextBlock Text="Which key or action should it trigger?"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentA}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding ActionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="16" Margin="0,0,0,14"/>

                                            <!-- Nickname -->
                                            <TextBlock Text="Your nickname for this button (optional):"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentA}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="16" Margin="0,0,0,14"/>

                                            <!-- Macro text -->
                                            <TextBlock Text="Should SARA type a phrase when pressed? (leave empty if not needed)"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentA}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding MacroText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="16" MinHeight="52" TextWrapping="Wrap"
                                                     VerticalAlignment="Stretch" AcceptsReturn="True"/>

                                        </StackPanel>
                                    </Border>
                                </GroupBox>

                                <!-- HOLD MODE & TREMOR -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0" Header="Hold Mode" Margin="0,0,6,0">
                                        <CheckBox Content="Hold / Toggle mode"
                                                  IsChecked="{Binding SelectedMappingRow.HoldMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Foreground="{StaticResource FgPrim}" FontWeight="Bold" FontSize="15"/>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1" Header="Quick Actions" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.LearnInputCommand}"
                                                    Content="Teach" Padding="10,4" FontSize="14" Margin="0,0,6,0"
                                                    ToolTip="Press the physical button to teach SARA what it is"/>
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.EditMappingCommand}"
                                                    Content="Test It" Padding="10,4" FontSize="14" Margin="0,0,6,0"
                                                    ToolTip="Try out this button"/>
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>

                                <!-- STEADINESS SETTINGS -->
                                <GroupBox Header="Steadiness Settings" Margin="0,12,0,0">
                                    <StackPanel>

                                        <CheckBox Content="My hand shakes — turn on steadiness helpers"
                                                  IsChecked="{Binding TremorEnabled}"
                                                  Margin="0,0,0,14" Foreground="{StaticResource FgPrim}"
                                                  FontWeight="Bold" FontSize="15"/>

                                        <!-- Reaction delay -->
                                        <StackPanel Margin="0,0,0,14" IsEnabled="{Binding TremorEnabled}">
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="Wait before registering a press"
                                                           FontWeight="Bold" Foreground="{StaticResource AccentA}" FontSize="15"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DebounceMs, StringFormat='{}{0} ms'}"
                                                           FontSize="14" Foreground="{StaticResource FgSub}"
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock FontSize="13" Foreground="{StaticResource FgSub}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4">
                                                Higher = SARA waits longer, so accidental quick taps are ignored
                                            </TextBlock>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="No wait" FontSize="12"
                                                           Foreground="{StaticResource FgSub}" Width="50"/>
                                                <TextBlock DockPanel.Dock="Right" Text="Longer wait" FontSize="12"
                                                           Foreground="{StaticResource FgSub}" Width="70" TextAlignment="Right"/>
                                                <Slider Minimum="0" Maximum="500" TickFrequency="10"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding DebounceMs, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding TremorEnabled}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Ignore tiny movements -->
                                        <StackPanel Margin="0,0,0,14" IsEnabled="{Binding TremorEnabled}">
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="Ignore tiny shaky movements"
                                                           FontWeight="Bold" Foreground="{StaticResource AccentA}" FontSize="15"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding AxisDeadZone, StringFormat='{}{0:P0}'}"
                                                           FontSize="14" Foreground="{StaticResource FgSub}"
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock FontSize="13" Foreground="{StaticResource FgSub}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4">
                                                Higher = more movement is ignored, good if your hand drifts a lot
                                            </TextBlock>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="Less" FontSize="12"
                                                           Foreground="{StaticResource FgSub}" Width="30"/>
                                                <TextBlock DockPanel.Dock="Right" Text="More" FontSize="12"
                                                           Foreground="{StaticResource FgSub}" Width="30" TextAlignment="Right"/>
                                                <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                        Value="{Binding AxisDeadZone, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding TremorEnabled}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Extra steadiness -->
                                        <StackPanel IsEnabled="{Binding TremorEnabled}">
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="Extra steadiness (smooth out shaking)"
                                                           FontWeight="Bold" Foreground="{StaticResource AccentA}" FontSize="15"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding AxisSmoothAlpha, StringFormat='{}{0:P0}'}"
                                                           FontSize="14" Foreground="{StaticResource FgSub}"
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock FontSize="13" Foreground="{StaticResource FgSub}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4">
                                                Higher = smoother movement, slightly less snappy — good for joystick shake
                                            </TextBlock>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="Less" FontSize="12"
                                                           Foreground="{StaticResource FgSub}" Width="30"/>
                                                <TextBlock DockPanel.Dock="Right" Text="More" FontSize="12"
                                                           Foreground="{StaticResource FgSub}" Width="30" TextAlignment="Right"/>
                                                <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                        Value="{Binding AxisSmoothAlpha, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding TremorEnabled}"/>
                                            </DockPanel>
                                        </StackPanel>

                                    </StackPanel>
                                </GroupBox>

                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>

            <!-- SPLITTER 2 -->
            <GridSplitter Grid.Column="3" Width="2"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentA}"/>

            <!-- COLUMN 4: LIVE TEST PANEL (RIGHT SIDE) -->
            <Border Grid.Column="4" Background="{StaticResource Bg1}"
                    BorderThickness="2" BorderBrush="{StaticResource Cyan}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Try It Out" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentA}" Margin="0,0,0,4"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Press any button, key, or move your device"
                                   FontSize="13" Foreground="{StaticResource FgSub}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- BIG live input display -->
                        <Border Background="{StaticResource Bg2}" BorderThickness="2"
                                BorderBrush="{StaticResource AccentA}" Padding="16" Margin="0,0,0,14"
                                MinHeight="100">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastInput}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource AccentB}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- What SARA will do -->
                        <Border Background="{StaticResource Bg2}" BorderThickness="2"
                                BorderBrush="{StaticResource AccentB}" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SARA will respond with:"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentA}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedMappingRow.CurrentMapping}"
                                           FontSize="16" Foreground="{StaticResource FgPrim}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Your device at a glance -->
                        <Border Background="{StaticResource Bg2}" BorderThickness="2"
                                BorderBrush="{StaticResource Cyan}" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Your Device" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentA}" Margin="0,0,0,8"/>
                                <ContentControl Content="{Binding SelectedDevice}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontSize="15" Margin="0,0,0,4">
                                                    <Run Text="Name:  " Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                                                    <Run Text="{Binding DeviceName}" Foreground="{StaticResource FgPrim}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="15" Margin="0,0,0,4">
                                                    <Run Text="Type:  " Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                                                    <Run Text="{Binding DeviceType}" Foreground="{StaticResource FgPrim}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="15">
                                                    <Run Text="Status:  " Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                                                    <Run Text="{Binding IsConnected}" Foreground="{StaticResource AccentB}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </Border>

                        <!-- Tips -->
                        <Border Background="{StaticResource Bg2}" BorderThickness="2"
                                BorderBrush="{StaticResource AccentA}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Quick Tips" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentA}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource FgSub}" Margin="0,0,0,6">
                                    Tap a button in the middle, then use
                                    "Teach SARA This Button" to set what it does.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource FgSub}" Margin="0,0,0,6">
                                    Check "My hand shakes" in Steadiness Settings
                                    if you press buttons by accident.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource FgSub}">
                                    Hit "Save My Settings" at the top when you're done.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource Bg2}"
                Padding="8,4" Margin="0,8,0,0" BorderThickness="2" BorderBrush="{StaticResource AccentB}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SARA is " FontSize="14" Foreground="{StaticResource FgSub}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="not connected"/>
                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaraConnected}" Value="True">
                                        <Setter Property="Text" Value="ready &#x2713;"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentB}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource AccentB}"
                           FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
