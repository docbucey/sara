<Window x:Class="DisabilityMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DisabilityMapper.ViewModels"
        Title="SARA — Accessibility Input Mapper"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#000000">

    <Window.Resources>
        <!-- HIGH CONTRAST COLORS -->
        <SolidColorBrush x:Key="Bg0"      Color="#000000"/>  <!-- Pure black -->
        <SolidColorBrush x:Key="Bg1"      Color="#1A1A1A"/>  <!-- Dark gray -->
        <SolidColorBrush x:Key="Bg2"      Color="#333333"/>  <!-- Medium gray -->
        <SolidColorBrush x:Key="AccentA"  Color="#FFFF00"/>  <!-- Bright yellow -->
        <SolidColorBrush x:Key="AccentB"  Color="#00FF00"/>  <!-- Bright green -->
        <SolidColorBrush x:Key="FgPrim"   Color="#FFFFFF"/>  <!-- Pure white -->
        <SolidColorBrush x:Key="FgSub"    Color="#CCCCCC"/>  <!-- Light gray -->
        <SolidColorBrush x:Key="Warning"  Color="#FF0000"/>  <!-- Bright red -->
        <SolidColorBrush x:Key="Cyan"     Color="#00FFFF"/>  <!-- Cyan highlight -->
        
        <vm:BoolToToggleLabelConverter x:Key="ToggleLabel"/>
        <vm:StringNotEmptyConverter    x:Key="NotEmpty"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource Bg1}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="CaretBrush"      Value="{StaticResource FgPrim}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource Bg1}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="15"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentA}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentA}"/>
                    <Setter Property="Foreground" Value="{StaticResource Bg0}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"      Value="{StaticResource AccentA}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin"          Value="0,8"/>
            <Setter Property="Padding"         Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource Bg2}" Padding="8" Margin="0,0,0,8" BorderThickness="2" BorderBrush="{StaticResource AccentA}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BtnStyle}"
                        Command="{Binding RefreshDevicesCommand}"
                        Content="Refresh Devices" Margin="0,0,8,0" FontSize="16"/>
                <Button Style="{StaticResource BtnStyle}"
                        Command="{Binding TogglePollingCommand}"
                        Content="{Binding IsPolling, Converter={StaticResource ToggleLabel}}"
                        Margin="0,0,8,0" FontSize="16"/>
                <Button Style="{StaticResource BtnStyle}"
                        Command="{Binding SaveAllCommand}"
                        Content="Save" FontSize="16"/>
                <Button Style="{StaticResource BtnStyle}"
                        Content="Office Suite" FontSize="16" Margin="8,0,0,0"
                        Click="OpenOffice_Click"
                        ToolTip="Open SARA Office Suite"/>
                <Button Style="{StaticResource BtnStyle}"
                        Content="UI Spec" FontSize="16" Margin="8,0,0,0"
                        Click="OpenSaraFallbackUi_Click"
                        ToolTip="MAMA/Mapper PNG spec — vector fallback (no PNG files)"/>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentA}">
                        <TextBlock.Text>Accessibility Input Mapper</TextBlock.Text>
                    </TextBlock>
                    <TextBlock FontSize="16" Foreground="{StaticResource FgSub}">
                        <TextBlock.Text>Works with any disability — mouse · gamepad · voice · switch · touch and more</TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT: 3-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="320" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0: DEVICE LIST -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}"
                    BorderThickness="2" BorderBrush="{StaticResource AccentA}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Devices"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentA}"
                               Margin="0,0,0,8"/>
                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource AccentB}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="15">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource FgSub}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeviceType}" FontSize="14" Foreground="{StaticResource Cyan}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground"  Value="{StaticResource FgPrim}"/>
                                <Setter Property="Background"  Value="Transparent"/>
                                <Setter Property="Padding"     Value="6,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Bg2}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentA}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- SPLITTER 1 -->
            <GridSplitter Grid.Column="1" Width="2"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentA}"/>

            <!-- COLUMN 2: MAPPER VISUALIZATION + SETTINGS -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource Bg0}">
                <ContentControl Content="{Binding SelectedDevice}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceProfileViewModel}">
                            <StackPanel Margin="12">

                                <!-- Device info header -->
                                <Border Background="{StaticResource Bg2}" Padding="8" Margin="0,0,0,12"
                                        BorderThickness="2" BorderBrush="{StaticResource Cyan}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentA}"/>
                                            <TextBlock Text="{Binding DeviceType}"
                                                       Foreground="{StaticResource Cyan}" FontSize="15" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="Active"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource FgPrim}"/>
                                    </Grid>
                                </Border>

                                <!-- Profile selector -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Profile:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="{StaticResource AccentA}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileNames}"
                                              SelectedItem="{Binding SelectedProfileName}" FontSize="15"/>
                                    <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource BtnStyle}"
                                            Command="{Binding AddProfileCommand}" Content="Add" Padding="8,2" FontSize="14"/>
                                    <Button Grid.Column="3" Margin="4,0,0,0" Style="{StaticResource BtnStyle}"
                                            Command="{Binding RemoveCurrentProfileCommand}" Content="Remove" Padding="8,2" FontSize="14"/>
                                </Grid>

                                <!-- INPUT BUTTON LAYOUT (Visual Grid) -->
                                <GroupBox Header="Button Layout — Click any button to configure" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="CLICK ANY BUTTON BELOW TO EDIT OR [LEARN] NEW INPUT"
                                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentA}"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Last input: " FontSize="14" Foreground="{StaticResource AccentA}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding LastInput}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentB}"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Button Grid -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding MappingRows}" Margin="0,0,0,12">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="6" Padding="16,12" FontSize="14" FontWeight="Bold"
                                                            Command="{Binding DataContext.SelectMappingCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="140" Height="100"
                                                            Background="{StaticResource Bg2}"
                                                            BorderThickness="2"
                                                            Foreground="{StaticResource FgPrim}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BtnStyle}">
                                                                <Setter Property="BorderBrush" Value="{StaticResource FgSub}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentA}"/>
                                                                        <Setter Property="Background" Value="{StaticResource Cyan}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Bg0}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding InputName}" FontSize="15" FontWeight="Bold" TextAlignment="Center" Foreground="Inherit"/>
                                                            <TextBlock Text="↓" TextAlignment="Center" FontSize="14" Margin="0,4,0,4" Foreground="Inherit"/>
                                                            <TextBlock Text="{Binding CurrentMapping}" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Foreground="Inherit" MaxWidth="120"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Quick Actions -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.LearnInputCommand}"
                                                    Content="Learn New Input" Padding="12,6" FontSize="15" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.EditMappingCommand}"
                                                    Content="Edit Selected" Padding="12,6" FontSize="15" Margin="0,0,8,0"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- DETAILED EDITOR -->
                                <GroupBox Header="Detailed Editor — Select a button above to edit" Margin="0,0,0,12">
                                    <Border Padding="8" Background="{StaticResource Bg1}" BorderThickness="2" BorderBrush="{StaticResource Cyan}">
                                        <Grid DataContext="{Binding SelectedMappingRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="INPUT:" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentA}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InputName}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentB}" Padding="6"/>

                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="ACTION:" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentA}"/>
                                            <ComboBox Grid.Row="0" Grid.Column="4"
                                                      ItemsSource="{Binding ActionTypes}"
                                                      SelectedItem="{Binding ActionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="15"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="TARGET VALUE:" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Margin="0,8,0,0" Foreground="{StaticResource AccentA}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                     Text="{Binding ActionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="15" Margin="0,8,0,0"/>

                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="LABEL:" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Margin="0,8,0,0" Foreground="{StaticResource AccentA}"/>
                                            <TextBox Grid.Row="1" Grid.Column="4"
                                                     Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="15" Margin="0,8,0,0"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MACRO TEXT:" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Margin="0,8,0,0" Foreground="{StaticResource AccentA}"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                                     Text="{Binding MacroText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="15" Margin="0,8,0,0" MinHeight="40" TextWrapping="Wrap" VerticalAlignment="Stretch" AcceptsReturn="True"/>
                                        </Grid>
                                    </Border>
                                </GroupBox>

                                <!-- HOLD MODE & TREMOR -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0" Header="Hold Mode" Margin="0,0,6,0">
                                        <CheckBox Content="Hold / Toggle mode"
                                                  IsChecked="{Binding SelectedMappingRow.HoldMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Foreground="{StaticResource FgPrim}" FontWeight="Bold" FontSize="15"/>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1" Header="Quick Actions" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.LearnInputCommand}"
                                                    Content="Learn" Padding="10,4" FontSize="14" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.EditMappingCommand}"
                                                    Content="Test" Padding="10,4" FontSize="14" Margin="0,0,6,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>

                                <!-- STABILITY & ACCESSIBILITY -->
                                <GroupBox Header="Input Stability" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.ColumnSpan="5"
                                                  Content="Enable tremor filter (debounce + dead-zone + smoothing)"
                                                  IsChecked="{Binding TremorEnabled}"
                                                  Margin="0,0,0,8" Foreground="{StaticResource FgPrim}" FontWeight="Bold"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="DEBOUNCE (ms):" VerticalAlignment="Center" Foreground="{StaticResource AccentA}" FontWeight="Bold"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DebounceMs, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding TremorEnabled}" FontSize="15"/>
                                        <Label Grid.Row="1" Grid.Column="3" Content="DEAD-ZONE (0-1):" VerticalAlignment="Center" Foreground="{StaticResource AccentA}" FontWeight="Bold"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding AxisDeadZone, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding TremorEnabled}" FontSize="15"/>
                                        <Label Grid.Row="2" Grid.Column="0" Content="SMOOTH (0-1):" VerticalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource AccentA}" FontWeight="Bold"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AxisSmoothAlpha, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding TremorEnabled}" Margin="0,6,0,0" FontSize="15"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                                                   Text="Lower = more smoothing"
                                                   FontSize="14" Foreground="{StaticResource Cyan}"
                                                   VerticalAlignment="Center" Margin="0,6,0,0" FontWeight="Bold"/>
                                    </Grid>
                                </GroupBox>

                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>

            <!-- SPLITTER 2 -->
            <GridSplitter Grid.Column="3" Width="2"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource AccentA}"/>

            <!-- COLUMN 4: BODY DIAGRAM (RIGHT SIDE) -->
            <Border Grid.Column="4" Background="{StaticResource Bg1}"
                    BorderThickness="2" BorderBrush="{StaticResource Cyan}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Body Map" FontSize="16" FontWeight="Bold" 
                                   Foreground="{StaticResource AccentA}" Margin="0,0,0,12"
                                   TextAlignment="Center"/>
                        
                        <!-- Simple body diagram representation -->
                        <Border Background="{StaticResource Bg2}" BorderThickness="2" BorderBrush="{StaticResource Cyan}"
                                Padding="8" Margin="0,0,0,12" CornerRadius="0">
                            <StackPanel>
                                <!-- HEAD -->
                                <Ellipse Width="60" Height="60" Fill="{StaticResource Cyan}" 
                                         Margin="0,0,0,8" HorizontalAlignment="Center"
                                         ToolTip="HEAD / HANDS"/>
                                
                                <!-- NECK CONNECTION -->
                                <Rectangle Height="8" Fill="{StaticResource AccentA}" Margin="25,0,25,0"/>
                                
                                <!-- TORSO -->
                                <Rectangle Height="80" Fill="{StaticResource AccentA}" 
                                          Margin="20,0,20,0"/>
                                
                                <!-- SHOULDERS -->
                                <Grid Height="20" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Fill="{StaticResource Warning}" 
                                            ToolTip="LEFT ARM"/>
                                    <TextBlock Grid.Column="1" Text="L  R" FontSize="16" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{StaticResource FgPrim}" FontWeight="Bold"/>
                                    <Ellipse Grid.Column="2" Fill="{StaticResource Warning}" 
                                            ToolTip="RIGHT ARM"/>
                                </Grid>

                                <!-- LEGS -->
                                <Grid Height="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{StaticResource AccentB}" 
                                              ToolTip="LEFT LEG" Margin="10,0,0,0"/>
                                    <Rectangle Grid.Column="2" Fill="{StaticResource AccentB}" 
                                              ToolTip="RIGHT LEG" Margin="0,0,10,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- INPUT LEGEND -->
                        <TextBlock Text="Input Legend" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource AccentA}" Margin="0,12,0,8"/>
                        
                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="14" Height="14" Fill="{StaticResource AccentB}" Margin="0,0,6,0"/>
                                <TextBlock Text="Active / On" Foreground="{StaticResource FgPrim}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="14" Height="14" Fill="{StaticResource Warning}" Margin="0,0,6,0"/>
                                <TextBlock Text="Warning / Armed" Foreground="{StaticResource FgPrim}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="14" Height="14" Fill="{StaticResource Cyan}" Margin="0,0,6,0"/>
                                <TextBlock Text="Selected / Focus" Foreground="{StaticResource FgPrim}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" Fill="{StaticResource AccentA}" Margin="0,0,6,0"/>
                                <TextBlock Text="Primary Action" Foreground="{StaticResource FgPrim}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- DEVICE STATUS -->
                        <Border Background="{StaticResource Bg2}" BorderThickness="2" BorderBrush="{StaticResource AccentB}"
                                Padding="6" Margin="0,12,0,0" CornerRadius="0">
                            <StackPanel>
                                <TextBlock Text="Device Status" FontSize="14" FontWeight="Bold"
                                          Foreground="{StaticResource AccentA}" Margin="0,0,0,6"/>
                                <ContentControl Content="{Binding SelectedDevice}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontSize="16" Margin="0,0,0,4">
                                                    <Run Text="Name: " Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                                                    <Run Text="{Binding DeviceName}" Foreground="{StaticResource FgPrim}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="16" Margin="0,0,0,4">
                                                    <Run Text="Type: " Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                                                    <Run Text="{Binding DeviceType}" Foreground="{StaticResource FgPrim}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="16" Margin="0,0,0,4">
                                                    <Run Text="Status: " Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                                                    <Run Text="{Binding IsConnected, StringFormat='Connected: {0}'}" Foreground="{StaticResource AccentB}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="16">
                                                    <Run Text="Enabled: " Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                                                    <Run Text="{Binding IsEnabled}" Foreground="{StaticResource FgPrim}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource Bg2}"
                Padding="8,4" Margin="0,8,0,0" BorderThickness="2" BorderBrush="{StaticResource AccentB}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SARA:" FontSize="14" Foreground="{StaticResource FgSub}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaraConnected}" Value="True">
                                        <Setter Property="Fill" Value="Lime"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource AccentB}"
                           FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
