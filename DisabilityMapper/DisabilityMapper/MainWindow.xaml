<Window x:Class="DisabilityMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DisabilityMapper.ViewModels"
        Title="VALANCE — by SARA"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B1829">

    <Window.Resources>
        <!-- ══ VALANCE DARK THEME ══════════════════════════════════════════════
             Navy   #1B4F8A  — VALANCE primary accent (G-Hub blue equivalent)
             Green  #2E9E6B  — Active / mapped / connected
             Amber  #E06B24  — Unmapped / warning / needs attention
             Sidebar deep dark  #07111E
             Main bg            #0B1829
             Card surface       #112236
             Raised element     #1A3450
             Profile bank A     #1B4F8A (navy)
             Profile bank B     #2E9E6B (green)
             Profile bank C     #7B3FA0 (purple — 3rd bank)
        ═══════════════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="Bg0"        Color="#0B1829"/>  <!-- Window bg -->
        <SolidColorBrush x:Key="Bg1"        Color="#112236"/>  <!-- Card surface -->
        <SolidColorBrush x:Key="Bg2"        Color="#1A3450"/>  <!-- Raised element -->
        <SolidColorBrush x:Key="BgSide"     Color="#07111E"/>  <!-- Deep sidebar -->
        <SolidColorBrush x:Key="AccentA"    Color="#1B4F8A"/>  <!-- VALANCE Navy -->
        <SolidColorBrush x:Key="AccentB"    Color="#2E9E6B"/>  <!-- VALANCE Green -->
        <SolidColorBrush x:Key="AccentC"    Color="#7B3FA0"/>  <!-- Profile C purple -->
        <SolidColorBrush x:Key="Amber"      Color="#E06B24"/>  <!-- Unmapped / warning -->
        <SolidColorBrush x:Key="FgPrim"     Color="#E8F0F8"/>  <!-- Primary text -->
        <SolidColorBrush x:Key="FgSub"      Color="#6A90B8"/>  <!-- Muted text -->
        <SolidColorBrush x:Key="Warning"    Color="#E04040"/>  <!-- Disconnect red -->
        <SolidColorBrush x:Key="Cyan"       Color="#4A90C8"/>  <!-- Info blue -->

        <!-- keep old names as aliases so bindings in ContentTemplate still resolve -->
        <SolidColorBrush x:Key="FgPrimAlias" Color="#E8F0F8"/>
        <SolidColorBrush x:Key="WarningAlias" Color="#E04040"/>
        
        <vm:BoolToToggleLabelConverter x:Key="ToggleLabel"/>
        <vm:StringNotEmptyConverter    x:Key="NotEmpty"/>

        <!-- Base text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>

        <!-- Input fields — dark on dark -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgSide}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="CaretBrush"      Value="{StaticResource AccentB}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource BgSide}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="15"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>

        <!-- GroupBox: subtle border on dark bg -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"      Value="{StaticResource Cyan}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Bg2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin"          Value="0,6"/>
            <Setter Property="Padding"         Value="8"/>
        </Style>

        <!-- Slider track colour -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentA}"/>
        </Style>

        <!-- Standard toolbar button — pill style like G-Hub top bar -->
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentA}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentA}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentA}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentB}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentB}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile BANK pill — like M1/M2/M3 on the G13 -->
        <Style x:Key="BankPillStyle" TargetType="Button" BasedOn="{StaticResource BtnStyle}">
            <Setter Property="Width"           Value="64"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Button MAP tile — the clickable button grid cards -->
        <Style x:Key="MapTile" TargetType="Button">
            <Setter Property="Width"           Value="148"/>
            <Setter Property="Height"          Value="90"/>
            <Setter Property="Margin"          Value="5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tile"
                                Background="#112236"
                                BorderBrush="#1A3450"
                                BorderThickness="2"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentA}"/>
                                <Setter TargetName="tile" Property="Background"  Value="#1A3450"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentB}"/>
                                <Setter TargetName="tile" Property="Background"  Value="#153828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar dark style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#07111E"/>
        </Style>

    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>    <!-- Top bar -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>    <!-- Status strip -->
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR — G-Hub style dark header ═══════════════════════════ -->
        <Border Grid.Row="0" Background="#07111E"
                BorderThickness="0,0,0,1" BorderBrush="#1B3450">
            <DockPanel Margin="12,0">

                <!-- Left: VALANCE wordmark -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentA}" CornerRadius="3"
                            Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="VALANCE" FontSize="16" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                    </Border>
                    <TextBlock Text="by SARA" FontSize="13" Foreground="{StaticResource FgSub}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: action buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnStyle}"
                            Command="{Binding RefreshDevicesCommand}"
                            Content="⟳  Find Devices" Margin="0,0,8,0"
                            ToolTip="Scan for any controllers, keyboards, or devices plugged in"/>
                    <Button Style="{StaticResource BtnStyle}"
                            Command="{Binding TogglePollingCommand}"
                            Content="{Binding IsPolling, Converter={StaticResource ToggleLabel}}"
                            Margin="0,0,8,0"
                            ToolTip="Start or stop watching your devices for input"/>
                    <Button Style="{StaticResource BtnStyle}"
                            Command="{Binding SaveAllCommand}"
                            Content="💾  Save"
                            Margin="0,0,8,0"
                            ToolTip="Save all your settings"/>
                    <Button Style="{StaticResource BtnStyle}"
                            Content="Office Suite" Margin="0,0,0,0"
                            Click="OpenOffice_Click"
                            ToolTip="Open the SARA Office Suite"/>
                </StackPanel>

                <!-- Center: subtitle -->
                <TextBlock Text="Any device → any app  •  controller · keyboard · joystick · voice · switch"
                           FontSize="13" Foreground="{StaticResource FgSub}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT: 3-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="300" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ── COLUMN 0: DEVICE SIDEBAR (G-Hub left panel) ────────────── -->
            <Border Grid.Column="0" Background="{StaticResource BgSide}">
                <DockPanel>
                    <!-- Sidebar header -->
                    <Border DockPanel.Dock="Top" Background="#07111E"
                            BorderThickness="0,0,0,1" BorderBrush="#1A3450" Padding="12,10">
                        <TextBlock Text="MY DEVICES" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource FgSub}"
/>
                    </Border>

                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background"    Value="Transparent"/>
                                <Setter Property="Foreground"    Value="{StaticResource FgPrim}"/>
                                <Setter Property="Padding"       Value="0"/>
                                <Setter Property="Margin"        Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1A3450"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#112236"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10">
                                    <DockPanel>
                                        <!-- Status LED dot (G-Hub style) -->
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8"
                                                 VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource AccentB}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                            <Setter Property="Fill" Value="#3A3A3A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource FgPrim}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DeviceType}"
                                                       FontSize="12" Foreground="{StaticResource FgSub}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- SPLITTER 1 -->
            <Border Grid.Column="1" Background="#1A3450"/>

            <!-- ── COLUMN 2: MAPPER MAIN AREA ────────────────────────────── -->
            <Grid Grid.Column="2" Background="{StaticResource Bg0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- device header + profile banks -->
                    <RowDefinition Height="*"/>       <!-- scrollable mapper content -->
                </Grid.RowDefinitions>

                <!-- Device header bar + M-bank selector -->
                <Border Grid.Row="0" Background="{StaticResource Bg1}"
                        BorderThickness="0,0,0,1" BorderBrush="#1A3450" Padding="14,10">
                    <ContentControl Content="{Binding SelectedDevice}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceProfileViewModel}">
                                <DockPanel>
                                    <!-- Profile bank pills — M1/M2/M3 equivalent -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="PROFILE" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource FgSub}"
 VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <!-- Bank A (navy) -->
                                        <Border CornerRadius="4" Margin="0,0,4,0">
                                            <Button Style="{StaticResource BankPillStyle}"
                                                    Background="{StaticResource AccentA}"
                                                    BorderBrush="{StaticResource AccentA}"
                                                    Foreground="White"
                                                    Command="{Binding AddProfileCommand}"
                                                    ToolTip="Profile A — click to add/switch">
                                                <TextBlock Text="A" FontSize="15" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Button>
                                        </Border>
                                        <!-- Bank B (green) -->
                                        <Border CornerRadius="4" Margin="0,0,4,0">
                                            <Button Style="{StaticResource BankPillStyle}"
                                                    Background="{StaticResource Bg2}"
                                                    BorderBrush="{StaticResource AccentB}"
                                                    Foreground="{StaticResource AccentB}"
                                                    ToolTip="Profile B — hold to set active bank">
                                                <TextBlock Text="B" FontSize="15" FontWeight="Bold"/>
                                            </Button>
                                        </Border>
                                        <!-- Bank C (purple) -->
                                        <Border CornerRadius="4">
                                            <Button Style="{StaticResource BankPillStyle}"
                                                    Background="{StaticResource Bg2}"
                                                    BorderBrush="{StaticResource AccentC}"
                                                    Foreground="{StaticResource AccentC}"
                                                    ToolTip="Profile C — hold to set active bank">
                                                <TextBlock Text="C" FontSize="15" FontWeight="Bold"/>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                    <!-- Device name + on/off toggle -->
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DeviceName}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="{StaticResource FgPrim}"
                                                       Margin="0,0,12,0"/>
                                            <CheckBox Content="Active"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center"
                                                      FontSize="13" Foreground="{StaticResource AccentB}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding DeviceType}" FontSize="13"
                                                       Foreground="{StaticResource Cyan}" Margin="0,0,12,0"/>
                                            <!-- Profile name pill -->
                                            <ComboBox ItemsSource="{Binding ProfileNames}"
                                                      SelectedItem="{Binding SelectedProfileName}"
                                                      FontSize="13" Height="24"
                                                      MinWidth="120"
                                                      Padding="6,2"/>
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding AddProfileCommand}"
                                                    Content="+" Padding="6,2" FontSize="13"
                                                    Margin="4,0,2,0" Height="24"
                                                    ToolTip="New profile"/>
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding RemoveCurrentProfileCommand}"
                                                    Content="✕" Padding="6,2" FontSize="13"
                                                    Height="24"
                                                    ToolTip="Delete profile"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <!-- Scrollable mapper body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource Bg0}">
                    <ContentControl Content="{Binding SelectedDevice}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceProfileViewModel}">
                                <StackPanel Margin="14,10,14,14">

                                <!-- ── BUTTON GRID — G-key style tile layout ── -->
                                <Border Background="{StaticResource Bg1}" CornerRadius="6"
                                        Padding="12" Margin="0,0,0,10">
                                    <!-- Header row -->
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="BUTTON LAYOUT" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource FgSub}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <!-- Legend -->
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentB}"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Mapped  " FontSize="12"
                                                           Foreground="{StaticResource FgSub}" VerticalAlignment="Center"/>
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource Amber}"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Empty  " FontSize="12"
                                                           Foreground="{StaticResource FgSub}" VerticalAlignment="Center"/>
                                                <!-- Live input badge -->
                                                <Border Background="{StaticResource Bg2}" CornerRadius="4"
                                                        Padding="8,3" Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentB}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="LIVE: " FontSize="12"
                                                                   Foreground="{StaticResource FgSub}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LastInput}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentB}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Button tiles grid — G-key style cards -->
                                        <ItemsControl ItemsSource="{Binding MappingRows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MapTile}"
                                                            Command="{Binding DataContext.SelectMappingCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="tile"
                                                                        CornerRadius="6"
                                                                        Background="#112236"
                                                                        BorderThickness="2"
                                                                        Width="148" Height="90"
                                                                        Margin="5">
                                                                    <!-- Colored left-edge bar (G-Hub key indicator) -->
                                                                    <Border.BorderBrush>
                                                                        <SolidColorBrush x:Name="tileBorder" Color="#1A3450"/>
                                                                    </Border.BorderBrush>
                                                                    <Grid>
                                                                        <!-- Left edge accent strip -->
                                                                        <Border HorizontalAlignment="Left" Width="4"
                                                                                CornerRadius="6,0,0,6">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="{StaticResource Amber}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsMapped}" Value="True">
                                                                                            <Setter Property="Background" Value="{StaticResource AccentB}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                        <!-- Content -->
                                                                        <StackPanel Margin="12,8,8,8"
                                                                                    HorizontalAlignment="Left"
                                                                                    VerticalAlignment="Top">
                                                                            <TextBlock Text="{Binding InputName}"
                                                                                       FontSize="13" FontWeight="Bold"
                                                                                       Foreground="{StaticResource FgPrim}"/>
                                                                            <TextBlock Text="{Binding CurrentMapping}"
                                                                                       FontSize="12" TextWrapping="Wrap"
                                                                                       MaxWidth="120" Margin="0,4,0,0">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock"
                                                                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                                        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsMapped}" Value="True">
                                                                                                <Setter Property="Foreground" Value="{StaticResource AccentB}"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="tile" Property="Background" Value="#1A3450"/>
                                                                        <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentA}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="tile" Property="Background" Value="#153828"/>
                                                                        <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentB}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Quick action row under the grid -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.LearnInputCommand}"
                                                    Content="⊕  Teach This Button" Padding="14,8" FontSize="14"
                                                    Margin="0,0,8,0"
                                                    ToolTip="Press the physical button to teach SARA what it is"/>
                                            <Button Style="{StaticResource BtnStyle}"
                                                    Command="{Binding SelectedMappingRow.EditMappingCommand}"
                                                    Content="⚙  Set It Up" Padding="14,8" FontSize="14"
                                                    ToolTip="Change what this button does"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── BUTTON SETUP PANEL ─────────────────────── -->
                                <Border Background="{StaticResource Bg1}" CornerRadius="6"
                                        Padding="14" Margin="0,0,0,10">
                                    <StackPanel DataContext="{Binding SelectedMappingRow}">
                                        <TextBlock Text="BUTTON SETUP" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource FgSub}"
                                                   Margin="0,0,0,10"/>

                                        <!-- Selected button badge -->
                                        <Border Background="{StaticResource Bg2}" CornerRadius="4"
                                                Padding="10,6" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Selected:  " FontSize="14"
                                                           Foreground="{StaticResource FgSub}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding InputName}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentB}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- What should it do -->
                                        <TextBlock Text="What should it do?" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Cyan}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding ActionTypes}"
                                                  SelectedItem="{Binding ActionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  FontSize="15" Margin="0,0,0,10"/>

                                        <!-- Key/action -->
                                        <TextBlock Text="Key or action:" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Cyan}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ActionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="15" Margin="0,0,0,10"/>

                                        <!-- Nickname -->
                                        <TextBlock Text="Your nickname for this button (optional):"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Cyan}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="15" Margin="0,0,0,10"/>

                                        <!-- Macro text -->
                                        <TextBlock Text="Type this phrase when pressed (leave empty if not needed):"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Cyan}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding MacroText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="15" MinHeight="52" TextWrapping="Wrap"
                                                 VerticalAlignment="Stretch" AcceptsReturn="True"
                                                 Margin="0,0,0,10"/>

                                        <!-- Hold toggle + quick actions -->
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left"
                                                      Content="Hold / Toggle mode"
                                                      IsChecked="{Binding HoldMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="14" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── STEADINESS SETTINGS ────────────────────── -->
                                <Border Background="{StaticResource Bg1}" CornerRadius="6"
                                        Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="STEADINESS" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource FgSub}"
                                                   Margin="0,0,0,10"/>

                                        <CheckBox Content="My hand shakes — turn on steadiness helpers"
                                                  IsChecked="{Binding TremorEnabled}"
                                                  Margin="0,0,0,14"
                                                  FontWeight="SemiBold" FontSize="14"/>

                                        <!-- Reaction delay -->
                                        <StackPanel Margin="0,0,0,14" IsEnabled="{Binding TremorEnabled}">
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="Wait before registering a press"
                                                           FontSize="13" Foreground="{StaticResource Cyan}"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding DebounceMs, StringFormat='{}{0} ms'}"
                                                           FontSize="13" Foreground="{StaticResource FgSub}"
                                                           HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource FgSub}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4">
                                                Higher = SARA waits longer, so accidental quick taps are ignored
                                            </TextBlock>
                                            <Slider Minimum="0" Maximum="500" TickFrequency="10"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding DebounceMs, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- Deadzone -->
                                        <StackPanel Margin="0,0,0,14" IsEnabled="{Binding TremorEnabled}">
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="Ignore tiny shaky movements"
                                                           FontSize="13" Foreground="{StaticResource Cyan}"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding AxisDeadZone, StringFormat='{}{0:P0}'}"
                                                           FontSize="13" Foreground="{StaticResource FgSub}"/>
                                            </DockPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource FgSub}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4">
                                                Higher = more movement is ignored, good if your hand drifts a lot
                                            </TextBlock>
                                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                    Value="{Binding AxisDeadZone, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- Smoothing -->
                                        <StackPanel IsEnabled="{Binding TremorEnabled}">
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="Extra steadiness (smooth out shaking)"
                                                           FontSize="13" Foreground="{StaticResource Cyan}"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding AxisSmoothAlpha, StringFormat='{}{0:P0}'}"
                                                           FontSize="13" Foreground="{StaticResource FgSub}"/>
                                            </DockPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource FgSub}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4">
                                                Higher = smoother movement, slightly less snappy — good for joystick shake
                                            </TextBlock>
                                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                    Value="{Binding AxisSmoothAlpha, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
            <!-- /Column 2 -->

            <!-- SPLITTER 2 -->
            <Border Grid.Column="3" Background="#1A3450"/>

            <!-- ── COLUMN 4: LIVE TEST / STATUS PANEL ────────────────────── -->
            <Border Grid.Column="4" Background="{StaticResource BgSide}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,14,14,14">

                        <!-- Section: LIVE INPUT (the big glowing readout) -->
                        <TextBlock Text="LIVE INPUT" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource FgSub}"
                                   Margin="0,0,0,8"/>

                        <!-- Big live display — glowing green border -->
                        <Border CornerRadius="6" Margin="0,0,0,10" MinHeight="90"
                                BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="#071A10"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#2E9E6B"/>
                            </Border.BorderBrush>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="12">
                                <TextBlock Text="{Binding LastInput}"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="#2E9E6B"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           FontFamily="Consolas"/>
                                <TextBlock Text="last input" FontSize="11"
                                           Foreground="{StaticResource FgSub}"
                                           TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Mapped action for that input -->
                        <Border Background="{StaticResource Bg1}" CornerRadius="6"
                                Padding="12" Margin="0,0,0,10" BorderThickness="1"
                                BorderBrush="{StaticResource AccentA}">
                            <StackPanel>
                                <TextBlock Text="MAPPED ACTION" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource FgSub}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedMappingRow.CurrentMapping}"
                                           FontSize="15" Foreground="{StaticResource FgPrim}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Device glance card -->
                        <Border Background="{StaticResource Bg1}" CornerRadius="6"
                                Padding="12" Margin="0,0,0,10" BorderThickness="1"
                                BorderBrush="{StaticResource Bg2}">
                            <StackPanel>
                                <TextBlock Text="DEVICE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource FgSub}"
                                           Margin="0,0,0,8"/>
                                <ContentControl Content="{Binding SelectedDevice}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Left" Text="Name" FontSize="12"
                                                               Foreground="{StaticResource FgSub}" Width="50"/>
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="13"
                                                               Foreground="{StaticResource FgPrim}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Left" Text="Type" FontSize="12"
                                                               Foreground="{StaticResource FgSub}" Width="50"/>
                                                    <TextBlock Text="{Binding DeviceType}" FontSize="13"
                                                               Foreground="{StaticResource Cyan}"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="Status" FontSize="12"
                                                               Foreground="{StaticResource FgSub}" Width="50"/>
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource AccentB}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                        <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Text" Value="Connected"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentB}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                        <Setter Property="Text" Value="Not found"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                        </Border>

                        <!-- Quick tips — dark card -->
                        <Border Background="{StaticResource Bg1}" CornerRadius="6"
                                Padding="12" BorderThickness="1" BorderBrush="{StaticResource Bg2}">
                            <StackPanel>
                                <TextBlock Text="QUICK GUIDE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource FgSub}"
                                           Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource FgSub}" Margin="0,0,0,6">
                                    1. Tap any button tile in the middle panel to select it.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource FgSub}" Margin="0,0,0,6">
                                    2. Click "Teach This Button" then press the physical button.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource FgSub}" Margin="0,0,0,6">
                                    3. Choose what it should do in "Button Setup."
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource FgSub}">
                                    4. Hit 💾 Save when done.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ STATUS STRIP — dark bottom bar ══════════════════════════════ -->
        <Border Grid.Row="2" Background="#07111E"
                BorderThickness="0,1,0,0" BorderBrush="#1A3450">
            <DockPanel Margin="14,0">
                <!-- Right: SARA connection LED -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaraConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentB}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="SARA offline"/>
                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaraConnected}" Value="True">
                                        <Setter Property="Text" Value="SARA ready"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentB}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- Left: status message -->
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource FgSub}"
                           FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
