<Window x:Class="DisabilityMapper.AssetDeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DisabilityMapper"
        Title="SARA — what you have (assets + backend)"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F6FA">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,10" Background="#FFEEF1F7"
                BorderBrush="#FFC9D1E0" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="SaraRootText" FontWeight="Bold" TextWrapping="Wrap" FontSize="14" Foreground="#FF1B2433"/>
                <TextBlock x:Name="HealthText" Margin="0,6,0,0" FontSize="15" Foreground="#FF2F6FED"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnMapper" Content="Open Mapper" Padding="14,8" Margin="0,0,8,0" Click="BtnMapper_OnClick"/>
                    <Button x:Name="BtnSpec" Content="Spec fallback (vector)" Padding="14,8" Margin="0,0,8,0" Click="BtnSpec_OnClick"/>
                    <Button x:Name="BtnFolder" Content="Open assets/png folder" Padding="14,8" Margin="0,0,8,0" Click="BtnFolder_OnClick"/>
                    <Button x:Name="BtnRefresh" Content="Refresh" Padding="14,8" Click="BtnRefresh_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" x:Name="CountText" Margin="0,8,0,0" FontSize="15" Foreground="#FF4B5A73"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ThumbsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:AssetThumbItem}">
                        <Border Width="200" Height="200" Margin="6" BorderBrush="#FF1B2433" BorderThickness="2" CornerRadius="8" Background="White">
                            <DockPanel Margin="6">
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                           FontSize="13" Foreground="#FF1B2433" TextWrapping="NoWrap" ToolTip="{Binding FullPath}"/>
                                <Grid>
                                    <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="150" MaxWidth="180"
                                           Visibility="{Binding ImageVisibility}"/>
                                    <TextBlock Text="MISSING" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold" Foreground="#FFB00020"
                                               Visibility="{Binding MissingVisibility}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
