<Window x:Class="DisabilityMapper.SaraFallbackShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SARA / MAMA — UI spec fallback (no PNGs, 4:3 + logical 0–10)"
        Width="1040" Height="820"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F6FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#FFF4F6FA"/>
        <SolidColorBrush x:Key="SurfaceMenu" Color="#FFEEF1F7"/>
        <SolidColorBrush x:Key="Border" Color="#FFC9D1E0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FF1B2433"/>
        <SolidColorBrush x:Key="Accent" Color="#FF2F6FED"/>
        <SolidColorBrush x:Key="Outline" Color="#FF1B2433"/>
        <SolidColorBrush x:Key="FieldGrass" Color="#FF6BCB59"/>
        <SolidColorBrush x:Key="FieldLine" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TargetRing" Color="#FFFFD54A"/>
        <SolidColorBrush x:Key="Plastic" Color="#FFB0B7C4"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceMenu}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10" Margin="0,0,0,12" CornerRadius="6">
            <StackPanel>
                <TextBlock Style="{StaticResource Hdr}" Text="Spec-driven fallback chrome"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}">
                    Logical layout uses 0–10 on each axis per 4:3 master (1000×750 here). PNGs can replace these vector shapes later; hit-testing can reuse the same numbers.
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Mapper shell: sidebar 0–2, profile bar y 0–1 full width, canvas 2–10 x 1–9 -->
                <TextBlock Style="{StaticResource Hdr}" Text="DisabilityMapper shell (sara_mapper_shell_*)"/>
                <Border BorderBrush="{StaticResource Outline}" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Viewbox Width="520" Height="390" Stretch="Uniform">
                        <Canvas Width="1000" Height="750" ClipToBounds="True">
                            <Border Canvas.Left="0" Canvas.Top="0" Width="1000" Height="750" Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="3" CornerRadius="8"/>
                            <!-- Sidebar x 0–2 -->
                            <Border Canvas.Left="0" Canvas.Top="0" Width="200" Height="750" Background="{StaticResource SurfaceMenu}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,2,0">
                                <TextBlock Text="Devices" FontWeight="Bold" Margin="12" Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                            <!-- Profile bar: x 2–10, y 0–1 -->
                            <Border Canvas.Left="200" Canvas.Top="0" Width="800" Height="75" Background="{StaticResource SurfaceMenu}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,2">
                                <TextBlock Text="Profile / status strip" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold"/>
                            </Border>
                            <!-- Mapping canvas: x 2–10, y 1–9 -->
                            <Border Canvas.Left="200" Canvas.Top="75" Width="800" Height="675" Background="#FFFFFFFF" BorderBrush="{StaticResource Border}" BorderThickness="2" CornerRadius="4">
                                <TextBlock Text="Mapping canvas (safe_rect inside PNG would match inner margin)" TextWrapping="Wrap" Margin="16" Opacity="0.7"/>
                            </Border>
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- Football 4:3 -->
                <TextBlock Style="{StaticResource Hdr}" Text="Football / calibration field (sara_football_field_bg)"/>
                <Border BorderBrush="{StaticResource Outline}" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Viewbox Width="520" Height="390" Stretch="Uniform">
                        <Canvas Width="1000" Height="750">
                            <Border Width="1000" Height="750" Background="{StaticResource FieldGrass}" BorderBrush="{StaticResource Outline}" BorderThickness="3" CornerRadius="6"/>
                            <!-- Yard lines (decorative) -->
                            <Line X1="500" Y1="40" X2="500" Y2="710" Stroke="{StaticResource FieldLine}" StrokeThickness="4"/>
                            <Line X1="80" Y1="375" X2="920" Y2="375" Stroke="{StaticResource FieldLine}" StrokeThickness="3" Opacity="0.85"/>
                            <Ellipse Canvas.Left="400" Canvas.Top="275" Width="200" Height="200" Stroke="{StaticResource FieldLine}" StrokeThickness="4" Fill="Transparent"/>
                            <!-- Target ring (safe game zone) -->
                            <Ellipse Canvas.Left="430" Canvas.Top="305" Width="140" Height="140" Stroke="{StaticResource Outline}" StrokeThickness="3" Fill="{StaticResource TargetRing}" Opacity="0.55"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- Joystick -->
                <TextBlock Style="{StaticResource Hdr}" Text="Joystick prop (sara_hid_joystick_base)"/>
                <Border BorderBrush="{StaticResource Outline}" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Viewbox Width="360" Height="270" Stretch="Uniform">
                        <Canvas Width="1000" Height="750">
                            <Ellipse Canvas.Left="250" Canvas.Top="420" Width="500" Height="220" Fill="{StaticResource Plastic}" Stroke="{StaticResource Outline}" StrokeThickness="3"/>
                            <Border Canvas.Left="420" Canvas.Top="180" Width="160" Height="280" Background="{StaticResource Plastic}" BorderBrush="{StaticResource Outline}" BorderThickness="3" CornerRadius="20"/>
                            <Ellipse Canvas.Left="430" Canvas.Top="120" Width="140" Height="140" Fill="#FFFF6B8A" Stroke="{StaticResource Outline}" StrokeThickness="3"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- Macro grid -->
                <TextBlock Style="{StaticResource Hdr}" Text="Macro pad plate (sara_hid_macro_grid_plate_empty)"/>
                <Border BorderBrush="{StaticResource Outline}" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,20" Padding="8">
                    <UniformGrid Rows="3" Columns="5" Width="500" Height="180">
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                        <Border Margin="3" CornerRadius="6" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFFFFFFF"/>
                    </UniformGrid>
                </Border>

                <!-- Keyboard plate: blank caps -->
                <TextBlock Style="{StaticResource Hdr}" Text="QWERTY plate — keys drawn in code later (sara_hid_keyboard_qwerty_plate)"/>
                <Border BorderBrush="{StaticResource Outline}" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,24" Padding="8">
                    <Canvas Width="640" Height="220" Background="#FFFFFFFF">
                        <!-- Row 1 -->
                        <Border Canvas.Left="10" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="52" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="94" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="136" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="178" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="220" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="262" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="304" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="346" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="388" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="430" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="472" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="514" Canvas.Top="12" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="556" Canvas.Top="12" Width="74" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <!-- Row 2 offset -->
                        <Border Canvas.Left="26" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="68" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="110" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="152" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="194" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="236" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="278" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="320" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="362" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="404" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="446" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="488" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="530" Canvas.Top="58" Width="36" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                        <Border Canvas.Left="572" Canvas.Top="58" Width="58" Height="36" CornerRadius="4" BorderBrush="{StaticResource Outline}" BorderThickness="2" Background="#FFEEF1F7"/>
                    </Canvas>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
