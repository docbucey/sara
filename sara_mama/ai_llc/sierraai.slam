#   osc   = |current_rule_id - previous_rule_id| > osc_threshold
#   rot   = (d1 * d2) < 0
#   noise = laggy + grain
#
#   base_stability = 1.0 if no rule_conflicts else (1.0 - rule_conflict_penalty)
#   composite = alpha*base_stability + beta*shi - gamma*(osc ? 1.0 : 0.0)
#   stable_score = composite / (1 + abs(noise))   # Bucey Shift
#
#   metrics_out <- {grain, laggy, shi, osc, rot, noise}
#   return stable_score