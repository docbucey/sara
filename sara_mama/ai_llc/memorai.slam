# ============================================================
# RECOVERY COORDINATION
# ============================================================

<memorai_recovery_coordinator> puppy%(
    nexus:[
        {module:"recovery_coordinator", purpose:"Coordinate system recovery when phoenix is invoked"},
        {coordination_flow:[
            "1. RECEIVE: Receive phoenix command from nicprocessor",
            "2. LOCATE: Find phoenixspark in boot sector",
            "3. CONNECT: Connect to cloud storage (via nicprocessor)",
            "4. DOWNLOAD: Retrieve phoenixash files",
            "5. VERIFY: Verify phoenixash integrity",
            "6. EXECUTE: Execute system restore procedure",
            "7. REFRESH: Generate new phoenixash + phoenixspark after restore"
        ]},
        {system_restore:[
            "Zero compromised sectors",
            "Restore from phoenixash backup",
            "Reinstall SARA core",
            "Restore continuity files",
            "Verify system integrity"
        ]}
    ]
)%


# ============================================================
# CARTIGENE STABILITY METRICS
# ============================================================

<memorai_cartigene> puppy%(
    nexus:[
        {metric:"grain", purpose:"backup completeness", formula:"|len(backup) - expected_size|"},
        {metric:"laggy", purpose:"generation timing", formula:"generation_time / expected_time"},
        {metric:"shi", purpose:"storage integrity", formula:"(stored_size + redundancy) / (original_size + 1)"},
        {metric:"osc", purpose:"detection avoidance", formula:"|current_state - hidden_state| > threshold"},
        {metric:"rot", purpose:"backup rotation", formula:"(new_backup * old_backup) < 0"},
        {metric:"bucey", purpose:"recovery readiness", formula:"value / (1 + |corruption|)"}
    ]
)%


