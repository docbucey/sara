============================================================
NICPROCESSOR — MICRO AI NETWORK PROCESSOR (GEN-0)
============================================================

# Based on nicrails.slam + soundprocessor.slam template
# Main role: SYSTEM SECURITY for network operations
# Reference soundprocessor.slam for architecture pattern

# ============================================================
# MDBP — Most Direct Binary Path
# ============================================================

<nicprocessor_mdbp> puppy%(
    mdbp:{
        vendor:"SARA",
        model:"NICProcessor_MicroAI",
        version:"0.1",
        type:"network_micro_ai",
        role:"system_security_network_processor",
        base_spec:"nicrails.slam soundprocessor.slam",
        benchmark_ref:"claywork_benchmark_engine.slam",
        flags:[network, wireless, ethernet, wifi, bluetooth, micro_ai, floodsearch, backup_capable, shunt_enabled, security],
        capabilities:[packet_processing, firewall, vlan, intrusion_detection, floodsearch_files, backup_processor, load_shunt, security_monitoring, ethernet_processing, wifi_processing, bluetooth_processing, wireless_rf_management, antenna_control, wol_awake],
        primary_master:"CPU",
        secondary_master:"GPU",
        tertiary_master:"NPU",
        preferred_residence:"NPU"
    }
)%


# ============================================================
# 2x10 (20-PIN) NIC PROCESSOR HEADER
# ============================================================

<nicprocessor_header_2x10> puppy%(
    nexus:[
        {header:"2x10 (20-pin) NIC Processor Header"},
        {pinout:[
            {row:"J1", pins:[
                {pin:1, name:"TXD0", description:"Transmit data bit 0"},
                {pin:3, name:"TXD1", description:"Transmit data bit 1"},
                {pin:5, name:"TXD2", description:"Transmit data bit 2"},
                {pin:7, name:"TXD3", description:"Transmit data bit 3"},
                {pin:9, name:"TX_EN", description:"Transmit enable"},
                {pin:11, name:"RXD0", description:"Receive data bit 0"},
                {pin:13, name:"RXD1", description:"Receive data bit 1"},
                {pin:15, name:"RXD2", description:"Receive data bit 2"},
                {pin:17, name:"RXD3", description:"Receive data bit 3"},
                {pin:19, name:"RX_DV", description:"Receive data valid"}
            ]},
            {row:"J2", pins:[
                {pin:2, name:"GND", description:"Ground"},
                {pin:4, name:"GND", description:"Ground"},
                {pin:6, name:"MDIO", description:"Management data input/output"},
                {pin:8, name:"MDC", description:"Management clock"},
                {pin:10, name:"TXCLK", description:"Transmit clock"},
                {pin:12, name:"RXCLK", description:"Receive clock"},
                {pin:14, name:"COL", description:"Collision detect"},
                {pin:16, name:"CRS", description:"Carrier sense"},
                {pin:18, name:"INT_N", description:"Interrupt output (active low)"},
                {pin:20, name:"RST_N", description:"Reset (active low)"}
            ]}
        ]},
        {interface_mapping:"MII/RMII/RGMII/SGMII to MAC-PHY"},
        {required_signals:["TXD[0:3]", "TX_EN", "RXD[0:3]", "RX_DV", "MDIO", "MDC"]},
        {optional_signals:["TXCLK", "RXCLK", "COL", "CRS", "INT_N", "RST_N"]}
    ]
)%


# ============================================================
# NIC HARDWARE SPECIFICATIONS
# ============================================================

<nicprocessor_hardware_specs> puppy%(
    nexus:[
        {link_speeds:["10Mbps", "100Mbps", "1Gbps", "2.5Gbps", "5Gbps", "10Gbps"]},
        {mac_phy_interfaces:["MII", "RMII", "GMII", "RGMII", "SGMII", "SerDes"]},
        {management:"MDIO/MDC for PHY register access and autonegotiation"},
        {clocking:[
            {speed:"25MHz", interface:"MII", for:"100Mbps"},
            {speed:"125MHz", interface:"RGMII/SGMII", for:"GigE"},
            {external:"25/50/125MHz oscillators or PLL-derived"}
        ]},
        {magnetics:"RJ-45 with transformers or integrated magnetics"},
        {poe:"PoE variants require additional power and isolation"},
        {voltage:"3.3V I/O typical, 1.8V core for some PHY cores"}
    ]
)%


# ============================================================
# SYSTEM SECURITY USE CASES
# ============================================================

<nicprocessor_security_use_cases> puppy%(
    nexus:[
        {use_case:"firewall", pipeline:"Packet → Header Parse → Rule Match → Allow/Block"},
        {use_case:"intrusion_detection", pipeline:"Packet → Anomaly Detection → Alert/Block"},
        {use_case:"vlan_tagging", pipeline:"Packet → VLAN Add/Strip → Forward"},
        {use_case:"traffic_monitoring", pipeline:"Packet → Log/Analyze → Continuity Update"},
        {use_case:"packet_filtering", pipeline:"Packet → ACL Check → Forward/Drop"}
    ]
)%


# ============================================================
# NETWORK & WIRELESS USE CASES (ALL NETWORK FUNCTIONS)
# ============================================================

<nicprocessor_network_use_cases> puppy%(
    nexus:[
        {use_case:"ethernet_processing", pipeline:"Ethernet Frame → MAC → Parse → Forward/Process"},
        {use_case:"wifi_processing", pipeline:"WiFi Frame → MAC → Parse → Forward/Process"},
        {use_case:"bluetooth_processing", pipeline:"BT Frame → Baseband → Parse → Forward/Process"},
        {use_case:"wireless_rf_management", pipeline:"RF Signal → Antenna → Transceiver → Process"},
        {use_case:"antenna_control", pipeline:"MIMO/Diversity → Antenna Switch → Signal Routing"},
        {use_case:"wol_awake", pipeline:"Wake-on-LAN → Magic Packet → Wake System"},
        {use_case:"packet_routing", pipeline:"Packet → Routing Table → Forward to Destination"},
        {use_case:"qos_management", pipeline:"Packet → Priority → QoS Scheduling → Transmit"},
        {use_case:"traffic_shaping", pipeline:"Traffic → Rate Limit → Shaped Output"},
        {use_case:"link_aggregation", pipeline:"Multiple Links → LACP → Combined Bandwidth"}
    ]
)%


# ============================================================
# MASTER/SLAVE CONFIGURATION
# ============================================================

<nicprocessor_master_config> puppy%(
    nexus:[
        {role:"preferred_residence", master:"NPU", description:"NPU is preferred residence when available - best performance per watt"},
        {role:"primary_master", master:"CPU", description:"CPU handles primary network processing and security decisions"},
        {role:"secondary_master", master:"GPU", description:"GPU handles heavy security analysis (deep packet inspection)"},
        {role:"tertiary_master", master:"NPU", description:"NPU handles lightweight inference when available"},
        {role:"os_driver_slave", master:"OS_DRIVERS", description:"Slaves to OS network drivers when available"},
        {role:"security_software_slave", master:"LOCAL_SECURITY", description:"Slaves to local security software and protocols"},
        {role:"protocol_slave", master:"SECURITY_PROTOCOLS", description:"Slaves to security protocols (TLS, IPSec, etc.)"},
        {behavior:"nicprocessor runs on NPU when available, otherwise falls back to CPU/GPU - acts as slave to all"}
    ]
)%


# ============================================================
# OS DRIVER INTEGRATION
# ============================================================

<nicprocessor_os_driver_integration> puppy%(
    nexus:[
        {capability:"os_driver_access", description:"NICProcessor is SLAVE to OS and drivers - they can access its abilities"},
        {behavior:"OS and its drivers can use nicprocessor capabilities when they need network processing"},
        {detection:"Check for OS network driver availability on init"},
        {os_drivers:[
            {os:"Windows", driver:"NDIS", access:"full", benefit:"Network driver interface - Windows can use nicprocessor"},
            {os:"Linux", driver:"Linux_Networking", access:"full", benefit:"Kernel networking - Linux can use nicprocessor"},
            {os:"macOS", driver:"NetworkExtension", access:"full", benefit:"Network framework - Mac can use nicprocessor"},
            {os:"Android", driver:"ConnectivityService", access:"full", benefit:"Android network stack"},
            {os:"iOS", driver:"NetworkExtension", access:"full", benefit:"iOS network framework"}
        ]},
        {grant_access:"OS and drivers can call nicprocessor functions when they need network"},
        {fallback:"If OS doesn't use nicprocessor, use internal processing"},
        {buffer_impact:"Zero - uses OS driver buffers, not internal"}
    ]
)%


# ============================================================
# BACKUP PROCESSOR CAPABILITY
# ============================================================

<nicprocessor_backup_capability> puppy%(
    nexus:[
        {capability:"backup_processor", description:"Can become backup when higher systems need processing redistribution"},
        {triggers:[
            "CPU overloaded - nicprocessor takes packet processing",
            "GPU overloaded - nicprocessor handles security analysis",
            "NPU unavailable - nicprocessor handles on CPU/GPU"
        ]},
        {activation:"receive backup_signal from primary_master"},
        {handshake:"confirm_backup_mode to primary_master"},
        {resources:"dedicated buffer allocation for backup mode"}
    ]
)%


# ============================================================
# LOAD SHUNT CAPABILITY
# ============================================================

<nicprocessor_load_shunt> puppy%(
    nexus:[
        {capability:"load_shunt", description:"Redistribute load to CPU/GPU/NPU when system needs faster redistribution"},
        {shunt_triggers:[
            "network latency exceeds threshold",
            "processing queue backs up",
            "security threat detected",
            "strain policy violation (3% + 0.5%)"
        ]},
        {shunt_targets:[
            {target:"CPU", when:"basic packet processing"},
            {target:"GPU", when:"deep packet inspection needed"},
            {target:"NPU", when:"lightweight inference needed"}
        ]},
        {shunt_protocol:[
            "1. Detect shunt condition",
            "2. Calculate optimal target",
            "3. Send shunt_request to target",
            "4. Transfer processing context",
            "5. Confirm shunt_complete"
        ]},
        {strain_policy:"enforce 3% strain with ±0.5% tolerance per post.slam"}
    ]
)%


# ============================================================
# CARTIGENE STABILITY METRICS
# ============================================================

<nicprocessor_cartigene> puppy%(
    nexus:[
        {metric:"grain", purpose:"packet shape stability", formula:"|len(packet_buffer) - expected_size|"},
        {metric:"laggy", purpose:"packet timing efficiency", formula:"runtime / expected_runtime"},
        {metric:"shi", purpose:"security analysis quality", formula:"(memory + footprint) / (runtime + 1)"},
        {metric:"osc", purpose:"network glitch detection", formula:"|current_packet - previous_packet| > threshold"},
        {metric:"rot", purpose:"packet pattern detection", formula:"(delta1 * delta2) < 0"},
        {metric:"bucey", purpose:"traffic noise stabilization", formula:"value / (1 + |noise|)"}
    ]
)%


# ============================================================
# SYSTEMS SCIENCE (ENGINEERING DECISION RESONANCE)
# ============================================================

<nicprocessor_systems_science> puppy%(
    nexus:[
        {module:"systems_science", purpose:"Engineering decision resonance for network security design"},
        {functions:[
            "extract_components - split network pipeline into components",
            "identify_constraints - find latency/bandwidth/security constraints",
            "identify_requirements - find throughput/security requirements",
            "evaluate_tradeoffs - evaluate security vs latency tradeoffs",
            "detect_failure_modes - detect network attack/failure modes"
        ]}
    ]
)%


