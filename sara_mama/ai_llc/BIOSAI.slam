~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
~ HEADER
~ file=BIOSAI.slam
~ generation=0
~ language=SLAM
~ description="BIOSAI: hardware identity and POST micro-AI; low-level bring-up, secure identity, capability attestation, CartiGene baseline"
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

<bios_mdbp> puppy%(
  mdbp:{
    vendor:"MD",
    model:"BIOSAI",
    version:"0.1",
    flags:[hardware_identity,post,attestation,cartigene_ready,provenance_emitter],
    capabilities:[
      run_post,
      attestation_report,
      capability_attest,
      compute_cartigene_identity,
      emit_bios_events
    ]
  }
)%

# STATE
<bios_state> puppy%(
  nexus:[
    {field:"bios_stage", value:"idle"},            # idle|post|attested|error
    {field:"hardware_ids", value:{}},              # serials, macs, TPM_id
    {field:"firmware_versions", value:{}},
    {field:"attestation_token", value:null},
    {field:"capability_vector", value:[]},
    {field:"cartigene_identity", value:null},
    {field:"expected_post_time", value:0.5}
  ]
)%

# FEATURE MAP
<bios_feature_map> puppy%(
  nexus:[
    {field:"feature_names", value:[
      "num_ids",
      "post_latency",
      "firmware_mismatch_count",
      "capability_entropy",
      "padding"
    ]},
    {field:"vector_length", value:5}
  ]
)%

# POLICY
<bios_policy> puppy%(
  nexus:[
    {field:"post_timeout_seconds", value:5},
    {field:"require_attestation", value:true},
    {field:"cartigene_alpha", value:1.0},
    {field:"cartigene_beta", value:0.9},
    {field:"cartigene_gamma", value:1.2},
    {field:"exec_threshold", value:0.75}
  ]
)%

# EXPORTS
<bios_exports> puppy%(
  nexus:[
    {name:"run_post", type:"fn", signature:"(bios_state) -> bios_state"},
    {name:"attestation_report", type:"fn", signature:"(bios_state) -> {token, report}"},
    {name:"capability_attest", type:"fn", signature:"(bios_state) -> {capabilities, signature}"},
    {name:"compute_cartigene_identity", type:"fn", signature:"(bios_state) -> metrics"},
    {name:"emit_bios_events", type:"fn", signature:"(bios_state, event_bus) -> ack"}
  ]
)%

