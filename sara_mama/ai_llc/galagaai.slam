~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
~ HEADER
~ file=GalagaAI.slam
~ generation=0
~ language=SLAM
~ description="GalagaAI: formation, attack waves, reactive tracking + CartiGene"
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

<galaga_mdbp> puppy%(
  mdbp:{
    vendor:"MD",
    model:"GalagaAI",
    version:"0.2",
    flags:[arcade_ai,cartigene_bound],
    capabilities:[update_enemies,spawn_wave,extract_features,score_with_cartigene]
  }
)%

<galaga_feature_map> puppy%(
  nexus:[
    {field:"feature_names", value:[
      "formation_integrity","dive_rate","player_alignment",
      "aggression","enemy_density","boss_state","timer","padding"
    ]},
    {field:"vector_length", value:8}
  ]
)%

<galaga_cartigene> puppy%(
  nexus:[
    {name:"grain",  expr:"abs(len(state) - expected_size)"},
    {name:"laggy",  expr:"runtime / expected_runtime"},
    {name:"shi",    expr:"(memory + footprint) / (runtime + 1)"},
    {name:"osc",    expr:"abs(current - previous) > threshold"},
    {name:"rot",    expr:"(d1 * d2) < 0"},
    {name:"bucey",  expr:"value / (1 + abs(noise))"}
  ]
)%

<galaga_policy> puppy%(
  nexus:[
    {field:"alpha", value:1.0},
    {field:"beta", value:0.7},
    {field:"gamma", value:0.6}
  ]
)%

<galaga_exports> puppy%(
  nexus:[
    {name:"update_enemies", type:"fn", signature:"(state,player) -> state"},
    {name:"spawn_wave", type:"fn", signature:"(stage) -> state"},
    {name:"extract_features", type:"fn", signature:"(state) -> [float]"},
    {name:"score_with_cartigene", type:"fn", signature:"(state,metrics_out) -> float"}
  ]
)%

# score_with_cartigene:
#   f = extract_features(state)
#   metrics = APPLY_CARTIGENE(f)
#   # here 'heuristic' can be a threat/pressure score
#   h = heuristic(state)
#   composite = alpha*h + beta*metrics.shi - gamma*metrics.osc
#   return metrics.bucey(composite, metrics.noise)